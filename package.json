{
  "name": "console-logs-remover",
  "displayName": "Console Logs Remover",
  "description": "Find, review, remove, comment out or insert console.log calls safely, with preview and undo. Works with JS, TS, React, Vue, Svelte, Astro and HTML.",
  "icon": "assets/ConsolelogRemover.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/iannjoroge120/Remove-Console-Logs.git"
  },
  "bugs": {
    "url": "https://github.com/iannjoroge120/Remove-Console-Logs/issues"
  },
  "homepage": "https://github.com/iannjoroge120/Remove-Console-Logs#readme",
  "license": "MIT",
  "version": "1.0.0",
  "publisher": "IanNjoroge",
  "engines": {
    "vscode": "^1.78.0"
  },
  "categories": [
    "Linters",
    "Formatters",
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "consoleLogsRemover.removeFromFile",
        "title": "Remove Console Logs in Current File",
        "category": "Console Logs",
        "icon": "$(trash)"
      },
      {
        "command": "consoleLogsRemover.removeFromSelection",
        "title": "Remove Console Logs in Selection",
        "category": "Console Logs"
      },
      {
        "command": "consoleLogsRemover.removeFromWorkspace",
        "title": "Remove Console Logs in Workspace",
        "category": "Console Logs",
        "icon": "$(trash)"
      },
      {
        "command": "consoleLogsRemover.removeFromExplorer",
        "title": "Remove Console Logs",
        "category": "Console Logs"
      },
      {
        "command": "consoleLogsRemover.removeFromChangedLines",
        "title": "Remove Console Logs in Lines Changed Since Last Commit",
        "category": "Console Logs",
        "icon": "$(git-commit)"
      },
      {
        "command": "consoleLogsRemover.removeInserted",
        "title": "Remove Inserted (Tagged) Logs in Workspace",
        "category": "Console Logs"
      },
      {
        "command": "consoleLogsRemover.commentOutInFile",
        "title": "Comment Out Console Logs in Current File",
        "category": "Console Logs"
      },
      {
        "command": "consoleLogsRemover.commentOutInSelection",
        "title": "Comment Out Console Logs in Selection",
        "category": "Console Logs"
      },
      {
        "command": "consoleLogsRemover.commentOutInWorkspace",
        "title": "Comment Out Console Logs in Workspace",
        "category": "Console Logs"
      },
      {
        "command": "consoleLogsRemover.uncommentInFile",
        "title": "Uncomment Console Logs in Current File",
        "category": "Console Logs"
      },
      {
        "command": "consoleLogsRemover.uncommentInWorkspace",
        "title": "Uncomment Console Logs in Workspace",
        "category": "Console Logs"
      },
      {
        "command": "consoleLogsRemover.insertLog",
        "title": "Insert Console Log for Selection",
        "category": "Console Logs"
      },
      {
        "command": "consoleLogsRemover.undo",
        "title": "Undo Last Change",
        "category": "Console Logs"
      },
      {
        "command": "consoleLogsRemover.showInFile",
        "title": "Show Console Logs in Current File",
        "category": "Console Logs"
      },
      {
        "command": "consoleLogsRemover.showOutput",
        "title": "Show Output",
        "category": "Console Logs"
      },
      {
        "command": "consoleLogsRemover.refreshView",
        "title": "Refresh",
        "category": "Console Logs",
        "icon": "$(refresh)"
      },
      {
        "command": "consoleLogsRemover.revealCall",
        "title": "Go to Console Call",
        "category": "Console Logs"
      },
      {
        "command": "consoleLogsRemover.removeTreeItem",
        "title": "Remove",
        "category": "Console Logs",
        "icon": "$(trash)"
      },
      {
        "command": "consoleLogsRemover.commentOutTreeItem",
        "title": "Comment Out",
        "category": "Console Logs",
        "icon": "$(comment)"
      },
      {
        "command": "extension.removeConsoleLogs",
        "title": "Remove Console Logs (legacy)"
      }
    ],
    "submenus": [
      {
        "id": "consoleLogsRemover.editorMenu",
        "label": "Console Logs"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "consoleLogsRemover.editorMenu",
          "when": "editorLangId in consoleLogsRemover.supportedLanguages",
          "group": "1_modification@90"
        }
      ],
      "consoleLogsRemover.editorMenu": [
        {
          "command": "consoleLogsRemover.insertLog",
          "group": "1_insert@1"
        },
        {
          "command": "consoleLogsRemover.removeFromSelection",
          "when": "editorHasSelection",
          "group": "2_remove@1"
        },
        {
          "command": "consoleLogsRemover.removeFromFile",
          "group": "2_remove@2"
        },
        {
          "command": "consoleLogsRemover.removeFromChangedLines",
          "group": "2_remove@3"
        },
        {
          "command": "consoleLogsRemover.commentOutInSelection",
          "when": "editorHasSelection",
          "group": "3_comment@1"
        },
        {
          "command": "consoleLogsRemover.commentOutInFile",
          "group": "3_comment@2"
        },
        {
          "command": "consoleLogsRemover.uncommentInFile",
          "group": "3_comment@3"
        },
        {
          "command": "consoleLogsRemover.undo",
          "when": "consoleLogsRemover.canUndo",
          "group": "4_undo@1"
        }
      ],
      "explorer/context": [
        {
          "command": "consoleLogsRemover.removeFromExplorer",
          "group": "7_modification@90",
          "when": "explorerResourceIsFolder || resourceExtname =~ /^\\.(m|c)?[jt]sx?$|^\\.(vue|svelte|astro|html?)$/"
        }
      ],
      "view/title": [
        {
          "command": "consoleLogsRemover.refreshView",
          "when": "view == consoleLogsRemover.view",
          "group": "navigation@1"
        },
        {
          "command": "consoleLogsRemover.removeFromWorkspace",
          "when": "view == consoleLogsRemover.view",
          "group": "navigation@2"
        },
        {
          "command": "consoleLogsRemover.removeFromChangedLines",
          "when": "view == consoleLogsRemover.view",
          "group": "navigation@3"
        },
        {
          "command": "consoleLogsRemover.commentOutInWorkspace",
          "when": "view == consoleLogsRemover.view",
          "group": "more@1"
        },
        {
          "command": "consoleLogsRemover.uncommentInWorkspace",
          "when": "view == consoleLogsRemover.view",
          "group": "more@2"
        },
        {
          "command": "consoleLogsRemover.removeInserted",
          "when": "view == consoleLogsRemover.view",
          "group": "more@3"
        },
        {
          "command": "consoleLogsRemover.undo",
          "when": "view == consoleLogsRemover.view && consoleLogsRemover.canUndo",
          "group": "more@4"
        }
      ],
      "view/item/context": [
        {
          "command": "consoleLogsRemover.commentOutTreeItem",
          "when": "view == consoleLogsRemover.view && viewItem == consoleLogsCall",
          "group": "inline@1"
        },
        {
          "command": "consoleLogsRemover.removeTreeItem",
          "when": "view == consoleLogsRemover.view && viewItem =~ /^consoleLogs(File|Call)$/",
          "group": "inline@2"
        },
        {
          "command": "consoleLogsRemover.commentOutTreeItem",
          "when": "view == consoleLogsRemover.view && viewItem == consoleLogsFile",
          "group": "1_actions@1"
        },
        {
          "command": "consoleLogsRemover.removeTreeItem",
          "when": "view == consoleLogsRemover.view && viewItem =~ /^consoleLogs(File|Call)$/",
          "group": "1_actions@2"
        }
      ],
      "commandPalette": [
        {
          "command": "consoleLogsRemover.removeFromFile",
          "when": "editorLangId in consoleLogsRemover.supportedLanguages"
        },
        {
          "command": "consoleLogsRemover.removeFromSelection",
          "when": "editorLangId in consoleLogsRemover.supportedLanguages"
        },
        {
          "command": "consoleLogsRemover.commentOutInFile",
          "when": "editorLangId in consoleLogsRemover.supportedLanguages"
        },
        {
          "command": "consoleLogsRemover.commentOutInSelection",
          "when": "editorLangId in consoleLogsRemover.supportedLanguages"
        },
        {
          "command": "consoleLogsRemover.uncommentInFile",
          "when": "editorLangId in consoleLogsRemover.supportedLanguages"
        },
        {
          "command": "consoleLogsRemover.insertLog",
          "when": "editorIsOpen"
        },
        {
          "command": "consoleLogsRemover.showInFile",
          "when": "editorLangId in consoleLogsRemover.supportedLanguages"
        },
        {
          "command": "consoleLogsRemover.undo",
          "when": "consoleLogsRemover.canUndo"
        },
        {
          "command": "consoleLogsRemover.removeFromChangedLines",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "consoleLogsRemover.removeFromExplorer",
          "when": "false"
        },
        {
          "command": "consoleLogsRemover.refreshView",
          "when": "false"
        },
        {
          "command": "consoleLogsRemover.revealCall",
          "when": "false"
        },
        {
          "command": "consoleLogsRemover.removeTreeItem",
          "when": "false"
        },
        {
          "command": "consoleLogsRemover.commentOutTreeItem",
          "when": "false"
        },
        {
          "command": "extension.removeConsoleLogs",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "consoleLogsRemover.insertLog",
        "key": "ctrl+alt+l",
        "mac": "ctrl+alt+l",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "command": "consoleLogsRemover.removeFromFile",
        "key": "ctrl+alt+shift+l",
        "mac": "ctrl+alt+shift+l",
        "when": "editorTextFocus && !editorReadonly && editorLangId in consoleLogsRemover.supportedLanguages"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "consoleLogsRemover.view",
          "name": "Console Logs",
          "icon": "$(debug-console)",
          "visibility": "collapsed"
        }
      ]
    },
    "configuration": {
      "title": "Console Logs Remover",
      "properties": {
        "consoleLogsRemover.methods": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "log",
              "debug",
              "info",
              "trace",
              "table",
              "dir",
              "dirxml",
              "time",
              "timeEnd",
              "timeLog",
              "count",
              "countReset",
              "group",
              "groupCollapsed",
              "groupEnd",
              "warn",
              "error",
              "assert",
              "clear",
              "profile",
              "profileEnd",
              "timeStamp"
            ]
          },
          "uniqueItems": true,
          "default": [
            "log",
            "debug",
            "info",
            "trace",
            "table",
            "dir",
            "dirxml",
            "time",
            "timeEnd",
            "timeLog",
            "count",
            "countReset",
            "group",
            "groupCollapsed",
            "groupEnd"
          ],
          "markdownDescription": "Which `console` methods to find and remove. `warn` and `error` are left out by default so real error reporting is kept."
        },
        "consoleLogsRemover.include": {
          "type": "string",
          "default": "**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,vue,svelte,astro,html}",
          "markdownDescription": "Glob of files to process in workspace and folder commands."
        },
        "consoleLogsRemover.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/dist/**",
            "**/build/**",
            "**/out/**",
            "**/.next/**",
            "**/.nuxt/**",
            "**/coverage/**",
            "**/*.min.js"
          ],
          "markdownDescription": "Globs to skip in workspace and folder commands."
        },
        "consoleLogsRemover.respectGitignore": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Skip files ignored by `.gitignore` (git repositories in trusted workspaces only)."
        },
        "consoleLogsRemover.ignoreComment": {
          "type": "string",
          "default": "keep-log",
          "markdownDescription": "A console call is kept when this text appears in a comment on the same line or the line above, e.g. `console.log(x); // keep-log`. Leave empty to disable."
        },
        "consoleLogsRemover.preview": {
          "type": "string",
          "enum": [
            "multipleFiles",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "Show the refactor preview when more than one file would change.",
            "Always show the refactor preview.",
            "Apply changes straight away (Undo is still offered)."
          ],
          "default": "multipleFiles",
          "markdownDescription": "When to show a diff preview before changing files."
        },
        "consoleLogsRemover.saveAfterChange": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Save files automatically after removing, commenting out or undoing."
        },
        "consoleLogsRemover.maxFileSizeKB": {
          "type": "number",
          "default": 1024,
          "minimum": 1,
          "markdownDescription": "Skip files larger than this in workspace scans."
        },
        "consoleLogsRemover.diagnostics.severity": {
          "type": "string",
          "enum": [
            "off",
            "hint",
            "information",
            "warning",
            "error"
          ],
          "default": "hint",
          "markdownDescription": "How console calls are marked in the editor. `hint` shows subtle dots; choose `warning` to make them stand out, or `off` to hide them. Quick Fixes are available either way."
        },
        "consoleLogsRemover.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the number of console calls in the current file in the status bar."
        },
        "consoleLogsRemover.insertLog.prefix": {
          "type": "string",
          "default": "🪵",
          "markdownDescription": "Text that starts every inserted log. It tags them so **Remove Inserted (Tagged) Logs** can remove only those."
        },
        "consoleLogsRemover.insertLog.includeLocation": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Include the file name and line number in inserted logs."
        },
        "consoleLogsRemover.insertLog.quote": {
          "type": "string",
          "enum": [
            "'",
            "\"",
            "`"
          ],
          "default": "'",
          "markdownDescription": "Quote style for inserted log labels."
        },
        "consoleLogsRemover.insertLog.method": {
          "type": "string",
          "enum": [
            "log",
            "debug",
            "info",
            "warn",
            "error",
            "table",
            "dir"
          ],
          "default": "log",
          "markdownDescription": "Console method used by **Insert Console Log**."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild extension.js --bundle --platform=node --target=node18 --format=cjs --external:vscode --minify --sourcemap --outfile=dist/extension.js",
    "watch": "npm run build -- --watch",
    "vscode:prepublish": "npm run build",
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "mocha --ui tdd \"test/unit/**/*.test.js\"",
    "pretest:integration": "npm run build",
    "test:integration": "node ./test/runTest.js",
    "package": "vsce package",
    "publish:vsce": "vsce publish"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "20.2.5",
    "@types/vscode": "^1.78.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.12",
    "eslint": "^8.41.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "typescript": "^5.1.3"
  },
  "dependencies": {
    "@babel/parser": "^7.29.9"
  },
  "keywords": [
    "console",
    "console.log",
    "log",
    "remove",
    "debug",
    "cleanup",
    "logger",
    "turbo",
    "javascript",
    "typescript",
    "react",
    "vue",
    "svelte"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Git features (\"only lines I changed\" and respecting .gitignore) are disabled in untrusted workspaces."
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Git features are unavailable in virtual workspaces."
    }
  }
}
