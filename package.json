{
  "name": "console-logs-remover",
  "displayName": "Console Logs Remover",
  "description": "Find, review, remove, comment out or insert console.log calls safely, with bulk actions, undo history and AI agent tools (Copilot, Claude Code, Cursor via MCP). JS, TS, React, Vue, Svelte, Astro, HTML.",
  "icon": "assets/ConsolelogRemover.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/iannjoroge120/Remove-Console-Logs.git"
  },
  "bugs": {
    "url": "https://github.com/iannjoroge120/Remove-Console-Logs/issues"
  },
  "homepage": "https://github.com/iannjoroge120/Remove-Console-Logs#readme",
  "license": "MIT",
  "version": "1.1.0",
  "publisher": "IanNjoroge",
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=18"
  },
  "categories": [
    "Linters",
    "Formatters",
    "AI",
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "consoleLogsRemover.removeFromFile",
        "title": "Remove Console Logs in Current File",
        "category": "Console Logs",
        "icon": "$(trash)"
      },
      {
        "command": "consoleLogsRemover.removeFromSelection",
        "title": "Remove Console Logs in Selection",
        "category": "Console Logs"
      },
      {
        "command": "consoleLogsRemover.removeFromWorkspace",
        "title": "Remove Console Logs in Workspace",
        "category": "Console Logs",
        "icon": "$(trash)"
      },
      {
        "command": "consoleLogsRemover.removeFromExplorer",
        "title": "Remove Console Logs",
        "category": "Console Logs"
      },
      {
        "command": "consoleLogsRemover.removeFromChangedLines",
        "title": "Remove Console Logs in Lines Changed Since Last Commit",
        "category": "Console Logs",
        "icon": "$(git-commit)"
      },
      {
        "command": "consoleLogsRemover.removeInserted",
        "title": "Remove Inserted (Tagged) Logs in Workspace",
        "category": "Console Logs"
      },
      {
        "command": "consoleLogsRemover.commentOutInFile",
        "title": "Comment Out Console Logs in Current File",
        "category": "Console Logs"
      },
      {
        "command": "consoleLogsRemover.commentOutInSelection",
        "title": "Comment Out Console Logs in Selection",
        "category": "Console Logs"
      },
      {
        "command": "consoleLogsRemover.commentOutInWorkspace",
        "title": "Comment Out Console Logs in Workspace",
        "category": "Console Logs"
      },
      {
        "command": "consoleLogsRemover.uncommentInFile",
        "title": "Uncomment Console Logs in Current File",
        "category": "Console Logs"
      },
      {
        "command": "consoleLogsRemover.uncommentInWorkspace",
        "title": "Uncomment Console Logs in Workspace",
        "category": "Console Logs"
      },
      {
        "command": "consoleLogsRemover.insertLog",
        "title": "Insert Console Log for Selection",
        "category": "Console Logs"
      },
      {
        "command": "consoleLogsRemover.undo",
        "title": "Undo Last Change",
        "category": "Console Logs",
        "icon": "$(discard)"
      },
      {
        "command": "consoleLogsRemover.showInFile",
        "title": "Review Console Logs in Current File",
        "category": "Console Logs"
      },
      {
        "command": "consoleLogsRemover.showOutput",
        "title": "Show Output",
        "category": "Console Logs"
      },
      {
        "command": "consoleLogsRemover.refreshView",
        "title": "Refresh",
        "category": "Console Logs",
        "icon": "$(refresh)"
      },
      {
        "command": "consoleLogsRemover.revealCall",
        "title": "Go to Console Call",
        "category": "Console Logs"
      },
      {
        "command": "consoleLogsRemover.removeTreeItem",
        "title": "Remove",
        "category": "Console Logs",
        "icon": "$(trash)"
      },
      {
        "command": "consoleLogsRemover.commentOutTreeItem",
        "title": "Comment Out",
        "category": "Console Logs",
        "icon": "$(comment)"
      },
      {
        "command": "extension.removeConsoleLogs",
        "title": "Remove Console Logs (legacy)"
      },
      {
        "command": "consoleLogsRemover.undoAll",
        "title": "Undo All Changes",
        "category": "Console Logs",
        "icon": "$(clear-all)"
      },
      {
        "command": "consoleLogsRemover.showHistory",
        "title": "Show Change History",
        "category": "Console Logs",
        "icon": "$(history)"
      },
      {
        "command": "consoleLogsRemover.review",
        "title": "Review Console Logs in Workspace",
        "category": "Console Logs",
        "icon": "$(checklist)"
      },
      {
        "command": "consoleLogsRemover.setupAi",
        "title": "Set Up AI Agents",
        "category": "Console Logs",
        "icon": "$(sparkle)"
      },
      {
        "command": "consoleLogsRemover.selectAll",
        "title": "Select All",
        "category": "Console Logs",
        "icon": "$(check-all)"
      },
      {
        "command": "consoleLogsRemover.clearSelection",
        "title": "Clear Selection",
        "category": "Console Logs",
        "icon": "$(close-all)"
      },
      {
        "command": "consoleLogsRemover.removeChecked",
        "title": "Remove Selected",
        "category": "Console Logs",
        "icon": "$(trash)"
      },
      {
        "command": "consoleLogsRemover.commentOutChecked",
        "title": "Comment Out Selected",
        "category": "Console Logs",
        "icon": "$(comment)"
      },
      {
        "command": "consoleLogsRemover.keepChecked",
        "title": "Keep Selected (add ignore comment)",
        "category": "Console Logs",
        "icon": "$(pass)"
      },
      {
        "command": "consoleLogsRemover.removeAllInView",
        "title": "Remove All Listed",
        "category": "Console Logs",
        "icon": "$(trash)"
      },
      {
        "command": "consoleLogsRemover.commentOutAllInView",
        "title": "Comment Out All Listed",
        "category": "Console Logs"
      },
      {
        "command": "consoleLogsRemover.keepAllInView",
        "title": "Keep All Listed (add ignore comment)",
        "category": "Console Logs"
      },
      {
        "command": "consoleLogsRemover.keepTreeItem",
        "title": "Keep (add ignore comment)",
        "category": "Console Logs",
        "icon": "$(pass)"
      }
    ],
    "submenus": [
      {
        "id": "consoleLogsRemover.editorMenu",
        "label": "Console Logs"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "consoleLogsRemover.editorMenu",
          "when": "editorLangId in consoleLogsRemover.supportedLanguages",
          "group": "1_modification@90"
        }
      ],
      "consoleLogsRemover.editorMenu": [
        {
          "command": "consoleLogsRemover.insertLog",
          "group": "1_insert@1"
        },
        {
          "command": "consoleLogsRemover.removeFromSelection",
          "when": "editorHasSelection",
          "group": "2_remove@1"
        },
        {
          "command": "consoleLogsRemover.removeFromFile",
          "group": "2_remove@2"
        },
        {
          "command": "consoleLogsRemover.removeFromChangedLines",
          "group": "2_remove@3"
        },
        {
          "command": "consoleLogsRemover.commentOutInSelection",
          "when": "editorHasSelection",
          "group": "3_comment@1"
        },
        {
          "command": "consoleLogsRemover.commentOutInFile",
          "group": "3_comment@2"
        },
        {
          "command": "consoleLogsRemover.uncommentInFile",
          "group": "3_comment@3"
        },
        {
          "command": "consoleLogsRemover.showInFile",
          "group": "0_review@1"
        },
        {
          "command": "consoleLogsRemover.undo",
          "when": "consoleLogsRemover.canUndo",
          "group": "4_undo@1"
        },
        {
          "command": "consoleLogsRemover.undoAll",
          "when": "consoleLogsRemover.canUndoAll",
          "group": "4_undo@2"
        }
      ],
      "explorer/context": [
        {
          "command": "consoleLogsRemover.removeFromExplorer",
          "group": "7_modification@90",
          "when": "explorerResourceIsFolder || resourceExtname =~ /^\\.(m|c)?[jt]sx?$|^\\.(vue|svelte|astro|html?)$/"
        }
      ],
      "view/title": [
        {
          "command": "consoleLogsRemover.review",
          "when": "view == consoleLogsRemover.view",
          "group": "navigation@1"
        },
        {
          "command": "consoleLogsRemover.selectAll",
          "when": "view == consoleLogsRemover.view && !consoleLogsRemover.hasChecked",
          "group": "navigation@2"
        },
        {
          "command": "consoleLogsRemover.clearSelection",
          "when": "view == consoleLogsRemover.view && consoleLogsRemover.hasChecked",
          "group": "navigation@2"
        },
        {
          "command": "consoleLogsRemover.removeChecked",
          "when": "view == consoleLogsRemover.view && consoleLogsRemover.hasChecked",
          "group": "navigation@3"
        },
        {
          "command": "consoleLogsRemover.removeAllInView",
          "when": "view == consoleLogsRemover.view && !consoleLogsRemover.hasChecked",
          "group": "navigation@3"
        },
        {
          "command": "consoleLogsRemover.undo",
          "when": "view == consoleLogsRemover.view && consoleLogsRemover.canUndo",
          "group": "navigation@4"
        },
        {
          "command": "consoleLogsRemover.refreshView",
          "when": "view == consoleLogsRemover.view",
          "group": "navigation@5"
        },
        {
          "command": "consoleLogsRemover.commentOutChecked",
          "when": "view == consoleLogsRemover.view && consoleLogsRemover.hasChecked",
          "group": "1_selection@1"
        },
        {
          "command": "consoleLogsRemover.keepChecked",
          "when": "view == consoleLogsRemover.view && consoleLogsRemover.hasChecked",
          "group": "1_selection@2"
        },
        {
          "command": "consoleLogsRemover.commentOutAllInView",
          "when": "view == consoleLogsRemover.view && !consoleLogsRemover.hasChecked",
          "group": "2_all@1"
        },
        {
          "command": "consoleLogsRemover.keepAllInView",
          "when": "view == consoleLogsRemover.view && !consoleLogsRemover.hasChecked",
          "group": "2_all@2"
        },
        {
          "command": "consoleLogsRemover.removeFromChangedLines",
          "when": "view == consoleLogsRemover.view",
          "group": "3_scope@1"
        },
        {
          "command": "consoleLogsRemover.removeInserted",
          "when": "view == consoleLogsRemover.view",
          "group": "3_scope@2"
        },
        {
          "command": "consoleLogsRemover.uncommentInWorkspace",
          "when": "view == consoleLogsRemover.view",
          "group": "3_scope@3"
        },
        {
          "command": "consoleLogsRemover.undoAll",
          "when": "view == consoleLogsRemover.view && consoleLogsRemover.canUndoAll",
          "group": "4_undo@1"
        },
        {
          "command": "consoleLogsRemover.showHistory",
          "when": "view == consoleLogsRemover.view && consoleLogsRemover.canUndo",
          "group": "4_undo@2"
        },
        {
          "command": "consoleLogsRemover.setupAi",
          "when": "view == consoleLogsRemover.view",
          "group": "5_ai@1"
        }
      ],
      "view/item/context": [
        {
          "command": "consoleLogsRemover.keepTreeItem",
          "when": "view == consoleLogsRemover.view && viewItem == consoleLogsCall",
          "group": "inline@1"
        },
        {
          "command": "consoleLogsRemover.commentOutTreeItem",
          "when": "view == consoleLogsRemover.view && viewItem == consoleLogsCall",
          "group": "inline@2"
        },
        {
          "command": "consoleLogsRemover.removeTreeItem",
          "when": "view == consoleLogsRemover.view && viewItem =~ /^consoleLogs(File|Call)$/",
          "group": "inline@3"
        },
        {
          "command": "consoleLogsRemover.removeTreeItem",
          "when": "view == consoleLogsRemover.view && viewItem =~ /^consoleLogs(File|Call)$/",
          "group": "1_actions@1"
        },
        {
          "command": "consoleLogsRemover.commentOutTreeItem",
          "when": "view == consoleLogsRemover.view && viewItem =~ /^consoleLogs(File|Call)$/",
          "group": "1_actions@2"
        },
        {
          "command": "consoleLogsRemover.keepTreeItem",
          "when": "view == consoleLogsRemover.view && viewItem =~ /^consoleLogs(File|Call)$/",
          "group": "1_actions@3"
        }
      ],
      "commandPalette": [
        {
          "command": "consoleLogsRemover.removeFromFile",
          "when": "editorLangId in consoleLogsRemover.supportedLanguages"
        },
        {
          "command": "consoleLogsRemover.removeFromSelection",
          "when": "editorLangId in consoleLogsRemover.supportedLanguages"
        },
        {
          "command": "consoleLogsRemover.commentOutInFile",
          "when": "editorLangId in consoleLogsRemover.supportedLanguages"
        },
        {
          "command": "consoleLogsRemover.commentOutInSelection",
          "when": "editorLangId in consoleLogsRemover.supportedLanguages"
        },
        {
          "command": "consoleLogsRemover.uncommentInFile",
          "when": "editorLangId in consoleLogsRemover.supportedLanguages"
        },
        {
          "command": "consoleLogsRemover.insertLog",
          "when": "editorIsOpen"
        },
        {
          "command": "consoleLogsRemover.showInFile",
          "when": "editorLangId in consoleLogsRemover.supportedLanguages"
        },
        {
          "command": "consoleLogsRemover.removeFromChangedLines",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "consoleLogsRemover.removeFromExplorer",
          "when": "false"
        },
        {
          "command": "consoleLogsRemover.refreshView",
          "when": "false"
        },
        {
          "command": "consoleLogsRemover.revealCall",
          "when": "false"
        },
        {
          "command": "consoleLogsRemover.removeTreeItem",
          "when": "false"
        },
        {
          "command": "consoleLogsRemover.commentOutTreeItem",
          "when": "false"
        },
        {
          "command": "extension.removeConsoleLogs",
          "when": "false"
        },
        {
          "command": "consoleLogsRemover.undo",
          "when": "consoleLogsRemover.canUndo"
        },
        {
          "command": "consoleLogsRemover.undoAll",
          "when": "consoleLogsRemover.canUndo"
        },
        {
          "command": "consoleLogsRemover.showHistory",
          "when": "consoleLogsRemover.canUndo"
        },
        {
          "command": "consoleLogsRemover.selectAll",
          "when": "false"
        },
        {
          "command": "consoleLogsRemover.clearSelection",
          "when": "false"
        },
        {
          "command": "consoleLogsRemover.removeChecked",
          "when": "false"
        },
        {
          "command": "consoleLogsRemover.commentOutChecked",
          "when": "false"
        },
        {
          "command": "consoleLogsRemover.keepChecked",
          "when": "false"
        },
        {
          "command": "consoleLogsRemover.keepTreeItem",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "consoleLogsRemover.insertLog",
        "key": "ctrl+alt+l",
        "mac": "ctrl+alt+l",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "command": "consoleLogsRemover.removeFromFile",
        "key": "ctrl+alt+shift+l",
        "mac": "ctrl+alt+shift+l",
        "when": "editorTextFocus && !editorReadonly && editorLangId in consoleLogsRemover.supportedLanguages"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "consoleLogsRemover.view",
          "name": "Console Logs",
          "icon": "$(debug-console)",
          "visibility": "collapsed"
        }
      ]
    },
    "configuration": {
      "title": "Console Logs Remover",
      "properties": {
        "consoleLogsRemover.methods": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "log",
              "debug",
              "info",
              "trace",
              "table",
              "dir",
              "dirxml",
              "time",
              "timeEnd",
              "timeLog",
              "count",
              "countReset",
              "group",
              "groupCollapsed",
              "groupEnd",
              "warn",
              "error",
              "assert",
              "clear",
              "profile",
              "profileEnd",
              "timeStamp"
            ]
          },
          "uniqueItems": true,
          "default": [
            "log",
            "debug",
            "info",
            "trace",
            "table",
            "dir",
            "dirxml",
            "time",
            "timeEnd",
            "timeLog",
            "count",
            "countReset",
            "group",
            "groupCollapsed",
            "groupEnd"
          ],
          "markdownDescription": "Which `console` methods to find and remove. `warn` and `error` are left out by default so real error reporting is kept."
        },
        "consoleLogsRemover.include": {
          "type": "string",
          "default": "**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,vue,svelte,astro,html}",
          "markdownDescription": "Glob of files to process in workspace and folder commands."
        },
        "consoleLogsRemover.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/dist/**",
            "**/build/**",
            "**/out/**",
            "**/.next/**",
            "**/.nuxt/**",
            "**/coverage/**",
            "**/*.min.js"
          ],
          "markdownDescription": "Globs to skip in workspace and folder commands."
        },
        "consoleLogsRemover.respectGitignore": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Skip files ignored by `.gitignore` (git repositories in trusted workspaces only)."
        },
        "consoleLogsRemover.ignoreComment": {
          "type": "string",
          "default": "keep-log",
          "markdownDescription": "A console call is kept when this text appears in a comment on the same line or the line above, e.g. `console.log(x); // keep-log`. Leave empty to disable."
        },
        "consoleLogsRemover.preview": {
          "type": "string",
          "enum": [
            "multipleFiles",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "Show the refactor preview when more than one file would change.",
            "Always show the refactor preview.",
            "Apply changes straight away (Undo is still offered)."
          ],
          "default": "multipleFiles",
          "markdownDescription": "When to show a diff preview before changing files."
        },
        "consoleLogsRemover.saveAfterChange": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Save files automatically after removing, commenting out or undoing."
        },
        "consoleLogsRemover.maxFileSizeKB": {
          "type": "number",
          "default": 1024,
          "minimum": 1,
          "markdownDescription": "Skip files larger than this in workspace scans."
        },
        "consoleLogsRemover.diagnostics.severity": {
          "type": "string",
          "enum": [
            "off",
            "hint",
            "information",
            "warning",
            "error"
          ],
          "default": "hint",
          "markdownDescription": "How console calls are marked in the editor. `hint` shows subtle dots; choose `warning` to make them stand out, or `off` to hide them. Quick Fixes are available either way."
        },
        "consoleLogsRemover.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the number of console calls in the current file in the status bar."
        },
        "consoleLogsRemover.insertLog.prefix": {
          "type": "string",
          "default": "🪵",
          "markdownDescription": "Text that starts every inserted log. It tags them so **Remove Inserted (Tagged) Logs** can remove only those."
        },
        "consoleLogsRemover.insertLog.includeLocation": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Include the file name and line number in inserted logs."
        },
        "consoleLogsRemover.insertLog.quote": {
          "type": "string",
          "enum": [
            "'",
            "\"",
            "`"
          ],
          "default": "'",
          "markdownDescription": "Quote style for inserted log labels."
        },
        "consoleLogsRemover.insertLog.method": {
          "type": "string",
          "enum": [
            "log",
            "debug",
            "info",
            "warn",
            "error",
            "table",
            "dir"
          ],
          "default": "log",
          "markdownDescription": "Console method used by **Insert Console Log**."
        }
      }
    },
    "languageModelTools": [
      {
        "name": "consoleLogs_find",
        "displayName": "Find Console Logs",
        "toolReferenceName": "consoleLogs",
        "canBeReferencedInPrompt": true,
        "icon": "$(debug-console)",
        "tags": [
          "console",
          "logging",
          "debugging",
          "cleanup"
        ],
        "userDescription": "Find console.log calls in the current file, the workspace or your uncommitted changes.",
        "modelDescription": "Lists console.log/debug/info/trace/table/etc. calls as \"path:line  code\", using the parser in the Console Logs Remover extension (comments and strings are ignored). Read-only. Calls the user marked with a // keep-log comment, and console.warn/error by default, are excluded. Use scope \"changed\" to list only logs added since the last commit.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "enum": [
                "file",
                "workspace",
                "changed"
              ],
              "description": "\"file\": the file open in the editor (or the files in \"paths\"). \"workspace\": every source file, or the folders in \"paths\". \"changed\": only lines added or modified since the last git commit - use this to clean up debugging logs you added during the current task."
            },
            "paths": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Optional files or folders, relative to the workspace root."
            },
            "methods": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Optional console methods to match, e.g. [\"log\",\"debug\"]. Defaults to the user's setting (all methods except warn and error)."
            }
          }
        }
      },
      {
        "name": "consoleLogs_apply",
        "displayName": "Remove Console Logs",
        "toolReferenceName": "removeConsoleLogs",
        "canBeReferencedInPrompt": true,
        "icon": "$(trash)",
        "tags": [
          "console",
          "logging",
          "debugging",
          "cleanup"
        ],
        "userDescription": "Remove, comment out, keep or uncomment console.log calls. Shows a confirmation and can be undone.",
        "modelDescription": "Removes (or comments out, keeps with a // keep-log comment, or uncomments) console calls without breaking syntax: sole bodies of if/loops become {}, arrow bodies become {}, and calls used as values become undefined. Prefer scope \"changed\" when cleaning up after your own debugging so pre-existing logs are untouched, or pass \"locations\" from consoleLogs_find to target specific calls. The user confirms before anything changes and can undo with \"Console Logs: Undo Last Change\".",
        "inputSchema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "remove",
                "comment",
                "keep",
                "uncomment"
              ],
              "description": "What to do. Default \"remove\"."
            },
            "scope": {
              "type": "string",
              "enum": [
                "file",
                "workspace",
                "changed"
              ],
              "description": "\"file\": the file open in the editor (or the files in \"paths\"). \"workspace\": every source file, or the folders in \"paths\". \"changed\": only lines added or modified since the last git commit - use this to clean up debugging logs you added during the current task."
            },
            "paths": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Optional files or folders, relative to the workspace root."
            },
            "methods": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Optional console methods to match, e.g. [\"log\",\"debug\"]. Defaults to the user's setting (all methods except warn and error)."
            },
            "locations": {
              "type": "array",
              "description": "Specific calls to act on, e.g. from consoleLogs_find. Overrides scope.",
              "items": {
                "type": "object",
                "properties": {
